        ],
        "title": "Health",
        "type": "object"
      },
      "IntegratorRun": {
        "additionalProperties": false,
        "properties": {
          "amplification_factor": {
            "description": "R(-kh), per-step velocity amplification.",
            "title": "Amplification Factor",
            "type": "number"
          },
          "diverged": {
            "title": "Diverged",
            "type": "boolean"
          },
          "dt_requested": {
            "description": "s",
            "title": "Dt Requested",
            "type": "number"
          },
          "exclusion_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exclusion Reason"
          },
          "final_position_error": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "m, at t = T",
            "title": "Final Position Error"
          },
          "final_velocity_error": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "m/s, at t = T",
            "title": "Final Velocity Error"
          },
          "h": {
            "description": "Effective step T/N, s. Convergence is fitted against this.",
            "title": "H",
            "type": "number"
          },
          "in_position_fit": {
            "title": "In Position Fit",
            "type": "boolean"
          },
          "in_velocity_fit": {
            "title": "In Velocity Fit",
            "type": "boolean"
          },
          "kh": {
            "description": "Step size in units of the drag time 1/k (dimensionless).",
            "title": "Kh",
            "type": "number"
          },
          "max_position_error": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "m; null if the run diverged",
            "title": "Max Position Error"
          },
          "max_velocity_error": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "m/s; null if the run diverged",
            "title": "Max Velocity Error"
          },
          "n_completed": {
            "title": "N Completed",
            "type": "integer"
          },
          "n_steps": {
            "title": "N Steps",
            "type": "integer"
          },
          "position_roundoff_floor": {
            "description": "m",
            "title": "Position Roundoff Floor",
            "type": "number"
          },
          "stability": {
            "enum": [
              "stable",
              "marginal",
              "unstable"
            ],
            "title": "Stability",
            "type": "string"
