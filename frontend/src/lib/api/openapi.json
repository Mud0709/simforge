    "schemas": {
      "AnalyticalResult": {
        "additionalProperties": false,
        "properties": {
          "apex_time": {
            "description": "s",
            "title": "Apex Time",
            "type": "number"
          },
          "flight_time": {
            "description": "s",
            "title": "Flight Time",
            "type": "number"
          },
          "impact_speed": {
            "description": "m/s",
            "title": "Impact Speed",
            "type": "number"
          },
          "max_height": {
            "description": "m",
            "title": "Max Height",
            "type": "number"
          },
          "method_note": {
            "title": "Method Note",
            "type": "string"
          },
          "range": {
            "description": "Horizontal distance at landing, m",
            "title": "Range",
            "type": "number"
          }
        },
        "required": [
          "flight_time",
          "range",
          "max_height",
          "apex_time",
          "impact_speed",
          "method_note"
        ],
        "title": "AnalyticalResult",
        "type": "object"
      },
      "AngleSweepRequest": {
        "additionalProperties": false,
        "properties": {
          "n_angles": {
            "default": 91,
            "description": "Number of evenly spaced angles from 0 to 90 degrees (91 = 1-degree steps).",
