            "type": "number"
          },
          "launch_angle_deg": {
            "default": 45.0,
            "description": "Launch angle above the horizontal, in degrees.",
            "maximum": 90.0,
            "minimum": 0.0,
            "title": "Launch Angle Deg",
            "type": "number"
          },
          "launch_height": {
            "default": 0.0,
