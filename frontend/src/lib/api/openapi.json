            "additionalProperties": {
              "type": "string"
            },
            "title": "Environment",
            "type": "object"
          },
          "input_hash": {
            "title": "Input Hash",
            "type": "string"
          },
          "inputs": {
            "additionalProperties": true,
            "description": "Validated inputs exactly as used by the run.",
            "title": "Inputs",
            "type": "object"
          },
          "model_id": {
            "title": "Model Id",
            "type": "string"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "summary": {
            "additionalProperties": true,
            "description": "Headline metrics; series are not stored.",
            "title": "Summary",
            "type": "object"
          }
        },
        "required": [
          "run_id",
          "model_id",
          "model_version",
          "created_at",
          "input_hash",
          "inputs",
          "summary",
          "environment"
        ],
        "title": "ExperimentRecord",
        "type": "object"
      },
