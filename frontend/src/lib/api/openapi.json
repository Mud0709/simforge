        "type": "object"
      },
      "IntegratorStudyRequest": {
        "additionalProperties": false,
        "properties": {
          "dt_values": {
            "description": "Requested time steps (s). Each run uses h = T/N with N = ceil(T/dt), so that every run ends exactly at the horizon T.",
            "items": {
              "description": "Requested time step in s.",
              "exclusiveMinimum": 0.0,
              "maximum": 100.0,
              "type": "number"
            },
            "maxItems": 12,
            "minItems": 2,
            "title": "Dt Values",
            "type": "array"
          },
          "methods": {
            "items": {
              "enum": [
                "euler",
                "rk4",
                "verlet"
              ],
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 1,
            "title": "Methods",
            "type": "array"
          },
          "parameters": {
            "$ref": "#/components/schemas/ProjectileParameters"
          },
          "save_experiment": {
            "default": true,
            "title": "Save Experiment",
            "type": "boolean"
          }
        },
        "title": "IntegratorStudyRequest",
        "type": "object"
      },
