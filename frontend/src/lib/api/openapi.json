          "dt_requested",
          "h",
          "n_steps",
          "kh",
          "amplification_factor",
          "stability",
          "diverged",
          "n_completed",
          "max_position_error",
          "max_velocity_error",
          "final_position_error",
          "final_velocity_error",
          "position_roundoff_floor",
          "velocity_roundoff_floor",
          "in_position_fit",
          "in_velocity_fit",
          "exclusion_reason"
