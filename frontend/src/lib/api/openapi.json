            "description": "Why no order was fitted, if none was.",
            "title": "Fit Note"
          },
          "method": {
            "enum": [
              "euler",
              "rk4",
              "verlet"
            ],
            "title": "Method",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "position_fit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OrderFitResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "position_local_orders": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Position Local Orders",
            "type": "array"
          },
          "position_reference": {
            "anyOf": [
