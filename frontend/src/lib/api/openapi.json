                "$ref": "#/components/schemas/OrderFitResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "velocity_local_orders": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Velocity Local Orders",
            "type": "array"
          },
          "velocity_reference": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReferenceLine"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "method",
          "name",
          "theoretical_order",
          "stability_limit_kh",
          "runs",
          "position_local_orders",
          "velocity_local_orders",
          "position_fit",
          "velocity_fit",
          "position_reference",
          "velocity_reference",
          "fit_note",
          "trajectory"
        ],
        "title": "MethodStudyResult",
        "type": "object"
      },
