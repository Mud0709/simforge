            "type": "number"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/MethodStudyResult"
            },
            "title": "Results",
            "type": "array"
          },
          "units": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Units",
            "type": "object"
          },
          "velocity_scale": {
            "description": "max |v| of the exact solution, m/s",
            "title": "Velocity Scale",
            "type": "number"
          }
        },
        "required": [
          "model",
          "parameters",
          "dt_values",
          "methods",
          "units",
          "assumptions",
          "horizon",
          "k",
          "position_scale",
          "velocity_scale",
          "fit_rule",
          "results",
          "exact_trajectory",
          "metadata"
        ],
        "title": "IntegratorStudyResponse",
        "type": "object"
      },
      "MethodStudyResult": {
        "additionalProperties": false,
        "properties": {
          "fit_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
