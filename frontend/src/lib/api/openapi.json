            "minimum": 10.0,
            "title": "N Angles",
            "type": "integer"
          },
          "parameters": {
            "$ref": "#/components/schemas/ProjectileParameters",
            "description": "Projectile settings. launch_angle_deg is ignored: the sweep varies it."
          },
          "save_experiment": {
            "default": true,
            "title": "Save Experiment",
            "type": "boolean"
          }
        },
        "title": "AngleSweepRequest",
        "type": "object"
      },
      "AngleSweepResponse": {
        "additionalProperties": false,
        "properties": {
          "angles_deg": {
            "items": {
              "type": "number"
            },
            "title": "Angles Deg",
            "type": "array"
          },
          "assumptions": {
            "items": {
              "$ref": "#/components/schemas/Assumption"
            },
            "title": "Assumptions",
            "type": "array"
          },
          "best_angle_deg": {
            "description": "Angle maximising the range, refined by a bounded Brent search (~1e-7 deg).",
            "title": "Best Angle Deg",
            "type": "number"
          },
          "best_range": {
            "description": "m",
            "title": "Best Range",
            "type": "number"
          },
          "flight_times": {
            "description": "s",
            "items": {
              "type": "number"
            },
            "title": "Flight Times",
            "type": "array"
          },
          "max_heights": {
            "description": "m",
            "items": {
              "type": "number"
            },
            "title": "Max Heights",
            "type": "array"
          },
          "metadata": {
            "$ref": "#/components/schemas/RunMetadata"
          },
          "method_note": {
            "title": "Method Note",
            "type": "string"
          },
          "model": {
            "$ref": "#/components/schemas/ModelInfo"
          },
          "parameters": {
            "$ref": "#/components/schemas/ProjectileParameters"
          },
          "ranges": {
            "description": "m",
            "items": {
              "type": "number"
            },
            "title": "Ranges",
            "type": "array"
          },
          "units": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Units",
            "type": "object"
          },
          "vacuum_best_angle_deg": {
            "description": "Closed-form best angle with no drag: tan(theta) = v0 / sqrt(v0^2 + 2 g h).",
            "title": "Vacuum Best Angle Deg",
            "type": "number"
          },
          "vacuum_best_range": {
            "description": "m, closed form with no drag",
            "title": "Vacuum Best Range",
            "type": "number"
          }
        },
        "required": [
          "model",
          "parameters",
          "units",
          "assumptions",
          "angles_deg",
          "ranges",
          "flight_times",
          "max_heights",
          "best_angle_deg",
          "best_range",
          "vacuum_best_angle_deg",
          "vacuum_best_range",
          "method_note",
          "metadata"
        ],
        "title": "AngleSweepResponse",
        "type": "object"
      },
      "Assumption": {
        "additionalProperties": false,
        "description": "A modelling assumption, stated so a reader can judge when the model stops applying.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "statement": {
            "title": "Statement",
            "type": "string"
          }
        },
        "required": [
          "id",
          "statement"
        ],
        "title": "Assumption",
        "type": "object"
      },
      "Comparison": {
        "additionalProperties": false,
        "properties": {
          "flight_time": {
            "$ref": "#/components/schemas/ErrorMetric"
          },
          "impact_speed": {
            "$ref": "#/components/schemas/ErrorMetric"
          },
          "max_energy_balance_residual": {
            "description": "max |KE + PE + W_drag - E0| / E0 over step nodes. Exactly 0 for the true solution, so this measures integration error only.",
            "title": "Max Energy Balance Residual",
            "type": "number"
          },
          "max_height": {
            "$ref": "#/components/schemas/ErrorMetric"
          },
          "max_position_error": {
            "description": "Max Euclidean distance (m) between numerical and exact positions, evaluated at the solver's accepted step nodes (no interpolation error).",
            "title": "Max Position Error",
            "type": "number"
          },
          "range": {
            "$ref": "#/components/schemas/ErrorMetric"
          }
        },
        "required": [
          "flight_time",
          "range",
          "max_height",
          "impact_speed",
          "max_position_error",
          "max_energy_balance_residual"
        ],
        "title": "Comparison",
        "type": "object"
      },
      "ErrorMetric": {
        "additionalProperties": false,
        "properties": {
          "absolute": {
            "title": "Absolute",
            "type": "number"
          },
          "relative": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "|numerical - analytical| / |analytical|; null when the reference is 0.",
            "title": "Relative"
          }
        },
        "required": [
          "absolute",
          "relative"
        ],
        "title": "ErrorMetric",
        "type": "object"
      },
      "ExperimentRecord": {
        "additionalProperties": false,
