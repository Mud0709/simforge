# Copy to backend/.env (backend settings) or export in your shell.
# Placeholders only — SimForge needs no secrets or API keys.

# --- Backend (FastAPI reads SIMFORGE_* from the environment or backend/.env) ---
# Path of the SQLite experiment log. Default: backend/data/simforge.sqlite3
SIMFORGE_DB_PATH=./data/simforge.sqlite3
# Origins allowed to call the API directly (JSON list). Not needed when using the Next.js proxy.
SIMFORGE_CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend (read by Next.js at build time) ---
# Where Next.js proxies /api/* requests.
BACKEND_URL=http://127.0.0.1:8000
